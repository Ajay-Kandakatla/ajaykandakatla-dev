# Public site env. Set these in Vercel → Settings → Environment Variables.
# All PUBLIC_* values get inlined into the static build and are visible in the
# browser — only put values that are safe to expose (anon API keys, public IDs).

# Supabase — backs the views + likes counters on each post.
# After creating the Supabase project and running supabase/schema.sql:
#   - URL: Project Settings → API → Project URL
#   - Anon key: Project Settings → API → anon / public
# Without these the PostStats component renders nothing (graceful skip).
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON=

# Giscus — GitHub Discussions powered comments.
# After enabling Discussions on the repo + installing the Giscus GitHub App:
#   1. Open https://giscus.app
#   2. Enter the repo (Ajay-Kandakatla/ajaykandakatla-dev)
#   3. Page mapping: pathname
#   4. Discussion category: Announcements (create it if missing)
#   5. Copy the data-repo-id and data-category-id values it prints
# Without these the Comments component renders nothing (graceful skip).
PUBLIC_GISCUS_REPO=Ajay-Kandakatla/ajaykandakatla-dev
PUBLIC_GISCUS_REPO_ID=
PUBLIC_GISCUS_CATEGORY=Announcements
PUBLIC_GISCUS_CATEGORY_ID=
