---
import BaseLayout from './BaseLayout.astro';
import { topicSlug } from '../utils/topics';
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'blog'>;
}

const { entry } = Astro.props;
const { data } = entry;
const url = new URL(`/blog/${entry.slug}/`, Astro.site).toString();

const coverSrc = data.coverUrl ?? (data.cover ? data.cover.src : undefined);
const coverAlt = data.coverAlt ?? data.title;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: data.title,
  description: data.description,
  datePublished: data.publishedAt.toISOString(),
  dateModified: (data.updatedAt ?? data.publishedAt).toISOString(),
  author: { '@type': 'Person', name: 'Ajay Kandakatla', url: 'https://ajaykandakatla.dev' },
  mainEntityOfPage: url,
  url,
  keywords: data.tags.join(', '),
  ...(coverSrc ? { image: coverSrc } : {}),
};
---

<BaseLayout
  title={data.title}
  description={data.description}
  canonical={url}
  type="article"
  publishedAt={data.publishedAt.toISOString()}
  updatedAt={data.updatedAt?.toISOString()}
  tags={data.tags}
  ogImage={coverSrc}
>
  <script
    slot="head"
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(jsonLd)}
  />
  <article class="mx-auto max-w-2xl px-6 py-12">
    {coverSrc && (
      <figure class="mb-10 -mx-6 sm:mx-0">
        <img
          src={coverSrc}
          alt={coverAlt}
          loading="eager"
          fetchpriority="high"
          class="w-full rounded-none sm:rounded-lg object-cover aspect-[16/9]"
        />
        {data.coverAlt && (
          <figcaption class="mt-2 px-6 sm:px-0 text-xs text-zinc-500 italic">{data.coverAlt}</figcaption>
        )}
      </figure>
    )}
    <header>
      <h1 class="text-4xl font-bold tracking-tight">{data.title}</h1>
      <p class="mt-3 text-sm text-zinc-500">
        <time datetime={data.publishedAt.toISOString()}>
          {data.publishedAt.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' })}
        </time>
      </p>
      {data.tags.length > 0 && (
        <ul class="mt-4 flex flex-wrap gap-2">
          {data.tags.map((tag) => (
            <li>
              <a
                href={`/blog/topics/${topicSlug(tag)}/`}
                class="inline-block rounded-full border border-zinc-800 px-3 py-0.5 text-xs text-zinc-400 hover:border-zinc-600 hover:text-zinc-200 transition-colors"
                rel="tag"
              >
                {tag}
              </a>
            </li>
          ))}
        </ul>
      )}
    </header>
    <div class="prose prose-invert prose-zinc mt-10 max-w-none">
      <slot />
    </div>
    {data.tags.length > 0 && (
      <footer class="mt-16 pt-8 border-t border-zinc-800">
        <p class="text-sm text-zinc-500">More on this site about</p>
        <ul class="mt-3 flex flex-wrap gap-2">
          {data.tags.map((tag) => (
            <li>
              <a
                href={`/blog/topics/${topicSlug(tag)}/`}
                class="inline-block rounded-full border border-zinc-800 px-3 py-1 text-sm hover:border-zinc-600 transition-colors"
                rel="tag"
              >
                {tag} →
              </a>
            </li>
          ))}
        </ul>
      </footer>
    )}
  </article>
</BaseLayout>
