---
/**
 * Giscus comments — GitHub Discussions powered.
 *
 * Free, no tracking, lightweight. Visitors log in with GitHub to comment.
 *
 * One-time setup (see SETUP.md):
 *   1. Enable Discussions on the ajaykandakatla-dev repo (Settings → General).
 *   2. Install the Giscus GitHub App: https://github.com/apps/giscus
 *   3. Configure at https://giscus.app — pick the "Announcements" category
 *      for blog posts. Copy the data-* values it generates.
 *   4. Add the values below as env vars (PUBLIC_GISCUS_*) or hardcode here.
 *
 * Without the env vars set, this component renders nothing.
 */
const repo = import.meta.env.PUBLIC_GISCUS_REPO ?? '';
const repoId = import.meta.env.PUBLIC_GISCUS_REPO_ID ?? '';
const category = import.meta.env.PUBLIC_GISCUS_CATEGORY ?? 'Announcements';
const categoryId = import.meta.env.PUBLIC_GISCUS_CATEGORY_ID ?? '';
const enabled = Boolean(repo && repoId && categoryId);
---

{enabled && (
  <section class="comments mt-16 pt-8 border-t border-zinc-800">
    <h2 class="text-lg font-semibold mb-4">Comments</h2>
    <script
      src="https://giscus.app/client.js"
      data-repo={repo}
      data-repo-id={repoId}
      data-category={category}
      data-category-id={categoryId}
      data-mapping="pathname"
      data-strict="0"
      data-reactions-enabled="1"
      data-emit-metadata="0"
      data-input-position="top"
      data-theme="dark_dimmed"
      data-lang="en"
      data-loading="lazy"
      crossorigin="anonymous"
      async
      is:inline
    />
  </section>
)}
