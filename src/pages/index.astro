---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf())
  .slice(0, 5);
---

<BaseLayout
  title="Ajay Kandakatla — Architect Manager, Frontend Engineer"
  description="Architect Manager at Synchrony. Twelve years of frontend engineering across eight cities. Notes on software, systems, and shipping."
>
  <main class="mx-auto max-w-2xl px-6 py-12">
    <section>
      <h1 class="text-4xl font-bold tracking-tight">Ajay Kandakatla</h1>
      <p class="mt-4 text-zinc-300 leading-relaxed">
        Architect Manager at Synchrony. Twelve years of frontend engineering across eight cities and six companies. I write about software, systems, and the gap between architecture diagrams and what actually ships.
      </p>
    </section>

    <section class="mt-16">
      <div class="flex items-baseline justify-between">
        <h2 class="text-xl font-semibold">Latest writing</h2>
        <a href="/blog/" class="text-sm text-zinc-400 hover:text-zinc-100">All posts →</a>
      </div>
      <ul class="mt-6 space-y-5">
        {posts.map((post) => (
          <li>
            <a href={`/blog/${post.slug}/`} class="block group">
              <p class="text-xs text-zinc-500 uppercase tracking-wide">
                {post.data.publishedAt.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' })}
              </p>
              <p class="mt-1 text-lg font-medium group-hover:underline underline-offset-4">{post.data.title}</p>
              <p class="mt-1 text-sm text-zinc-400 line-clamp-2">{post.data.description}</p>
            </a>
          </li>
        ))}
      </ul>
    </section>
  </main>
</BaseLayout>
